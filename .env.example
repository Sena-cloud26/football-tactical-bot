# Salin file ini menjadi .env untuk pengujian lokal (opsional).
# Di aplikasi ini, API Key sebenarnya dimasukkan langsung via sidebar UI,
# jadi file .env ini hanya diperlukan jika kamu memodifikasi app.py untuk membaca dari environment.

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
